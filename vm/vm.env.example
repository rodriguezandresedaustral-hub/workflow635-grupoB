# Copiar a vm/vm.env (no se commitea) y completar. Lo lee vm/lanzar.sh.

# proyecto de GCP (gcloud projects list)
PROJECT=
REGION=northamerica-northeast2
ZONE=northamerica-northeast2-b

# template de la catedra (gcloud compute instance-templates list)
# to-128ram-12vcpu = n2 custom, 12 vCPU, 128 GB, Spot (usa toda la cuota de 12)
TEMPLATE=to-128ram-12vcpu

# nombre del bucket, sin gs://
BUCKET=
# donde aparece montado el bucket adentro de la VM
BUCKET_DIR_VM=/home/ds/buckets/b1

# la VM se llama <prefijo>-a / <prefijo>-b
VM_PREFIJO=wf635

# 1 = 30 min despues de terminar (bien o con error) la VM baja el grupo a 0
#     y no se recrea. 0 = queda prendida (cobra) hasta vm/parar.sh
APAGAR_AL_TERMINAR=1
