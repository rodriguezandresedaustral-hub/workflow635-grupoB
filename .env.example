# Configuracion de una corrida. Copiar a .env.A / .env.B (no se commitean)
# y completar. vm/lanzar.sh lo sube al bucket como .env.
# Formato KEY=valor, sin espacios ni comillas.

# A: valida 202107, predice 202109, sube a Kaggle
# B: valida 202105, predice 202107, calcula la ganancia en 202107
GRUPO=A

# carpeta de salida: <BUCKET_DIR>/exp/WF<EXPERIMENTO>. Uno distinto por corrida.
EXPERIMENTO=9500

# una corrida completa por semilla (genetica, canaritos, BO y modelo final con
# esa semilla como primigenia), en orden, cada una en WF<EXPERIMENTO>_s<semilla>.
# Vacio = una sola corrida en WF<EXPERIMENTO> con la semilla 100213.
SEMILLAS_PIPELINE=100213,100313,100613,100913,101113,570991,669287,832421,882599

# --- variantes del experimento (vacio = como el z635 / como WF9501) ---------
# techo del rango de la BO en log2: z635 = 10 (1024 arboles) y 11 (2048 hojas)
BO_TECHO_LOG2_ITERACIONES=10
BO_TECHO_LOG2_HOJAS=11
# genetica: 1 = corre despues del FE historico y mide cada formula con sus lags
# y deltas; 0 = antes, solo con los campos del mes
GA_CON_HISTORIA=0
# 1 (con GA_CON_HISTORIA=1) = las formulas combinan tambien lags, deltas y
# tendencias; 0 = solo los campos del mes
GA_COMBINAR_HISTORIA=0
GA_POBLACION=30
GA_GENERACIONES=20

# --- genetica v2 (todo opcional; vacio = default) ---------------------------
# genetica = busca y controla | azar = una formula sorteada por ronda, sin
# busqueda (brazo de control) | nada = sin FE genetico (brazo base) |
# transferencia = no corre el workflow: mide si las formulas de la genetica
# siguen sirviendo en meses posteriores, contra formulas al azar, y termina
GA_MODO=genetica
# 1 = las ganadoras entran aunque no pasen el control (queda registrado)
GA_FORZAR=0
# meses de la genetica: nunca los de la BO ni el testing.
# default A: busca 202103, controla 202105 | B: busca 202101, controla 202103
GA_VALIDA_BUSQUEDA=
GA_VALIDA_CONTROL=
# meses de entrenamiento antes de cada mes (con 1 de gap; vacio o 0 = todos
# desde 201901, como la v1; 6 = los 6 anteriores, ~4 veces mas rapido) y % de CONTINUA
GA_VENTANA=
GA_UNDERSAMPLING=0.2
# formulas al azar contra las que compite la ganadora (p = 1/(n+1))
GA_N_CONTROL=19
GA_RONDAS=3
# solo con GA_MODO=transferencia (vacio = default)
# default A: busca en 202101 y 202103, mide en 202103, 202105 y 202107
TRF_BUSQUEDAS=
TRF_MEDIR=
# cuantas formulas de la genetica (y otras tantas al azar) se vuelven a medir
TRF_TOP=20

# --- atajos para experimentos (vacio = como siempre) -------------------------
# BO_log.txt de otra corrida: usa su mejor fila y no corre la BO
HT_FIJO=
# semillas del semillerio final (default 9) y % de CONTINUA del final train (1 = todos)
FT_SEMILLAS_N=
FT_UNDERSAMPLING=
# 0 = el grupo A no sube a Kaggle (los CSV quedan en la carpeta igual)
KAGGLE_SUBIR=1

# rutas ADENTRO de la VM
BUCKET_DIR=/home/ds/buckets/b1
DATASET_PATH=/home/ds/buckets/b1/datasets/analistasr_competencia_2026.csv.gz

# --- mail -----------------------------------------------------------------
# cuenta de Gmail que manda (necesita una app password:
#   https://myaccount.google.com/apppasswords)
MAIL_FROM=
# archivo con la app password (16 caracteres, una linea). En el bucket,
# porque la VM Spot se borra al expropiarse. NUNCA en este repo.
MAIL_PASS_FILE=/home/ds/buckets/b1/secrets/gmail_app_password
# destinatarios, uno por linea (# comenta). En el bucket, no en el repo.
MAIL_TO_FILE=/home/ds/buckets/b1/wf635/destinatarios.txt
# mail de avance cada N evaluaciones de la optimizacion bayesiana (0 = nunca)
MAIL_CADA_ITER=5

# --- kaggle (solo grupo A) ------------------------------------------------
KAGGLE_JSON=/home/ds/buckets/b1/kaggle/kaggle.json
KAGGLE_COMPETENCIA=labo-1-ba-2026-analista-sr
# binario del CLI de kaggle si no esta en el PATH
KAGGLE_BIN=kaggle
